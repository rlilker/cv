---
/**
 * Family Assistant dashboard (Tasks 3 and 4 of dashboard-plan.md).
 *
 * A static Astro page with no server component. Everything it needs comes from
 * two places at runtime:
 *
 *   Google Identity Services  -> an ID token, exchanged for a Firebase session
 *   Firestore                 -> config/app_settings and runs/{run_id}
 *
 * The Pi service writes the runs and reads the config; this page reads the runs
 * and writes the config. Neither side calls the other's HTTP API.
 *
 * Security posture: this is a static file on S3. Anyone can fetch it, including
 * the OAuth client id, so *nothing* here is a secret and *nothing* here is
 * trusted. Access control lives entirely in firestore.rules, which grants on an
 * email allowlist. If you find yourself adding a secret to this file, the design
 * is wrong.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import app from '../../data/family-assistant.json';

// Public Firebase config, injected at build time. Absent in local dev until the
// values from docs/DEPLOY_FIRESTORE.md are exported.
const fb = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN ?? '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? '',
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID ?? '',
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID ?? '',
  vapidKey: import.meta.env.PUBLIC_FIREBASE_VAPID_KEY ?? '',
};

// The OAuth web client id is the one thing the Identity Services SDK needs.
// It is deliberately NOT sent to Firestore or used for signing anything. It is
// a public identifier: this flow uses no client secret, and could not use one
// from a browser even if we wanted to.
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';

const configured = Boolean(fb.apiKey && fb.projectId);
const signInConfigured = Boolean(googleClientId);

const title = 'Dashboard — Family Assistant';
const description =
  'Private control panel for the Family Assistant: run history, extraction '
  + 'settings, and notification setup.';
---

<BaseLayout title={title} description={description}>
  <div id="top"></div>

  <Nav current="projects" />

  <main class="page" id="main">
    <article class="dash">
      <a class="back-link" href="/family-assistant">
        <span aria-hidden="true">&larr;</span> Back to {app.name}
      </a>

      <header class="dash-head">
        <h1>Dashboard</h1>
        <p class="dash-sub">
          Run history and settings for the {app.name} service running on the
          Raspberry Pi.
        </p>
      </header>

      {/*
        The Firebase web config, injected at build time from PUBLIC_* env vars.
        These values identify the project; they do not authorise anything. Access
        is granted by firestore.rules based on an email allowlist, so this blob
        being public is expected and harmless.
      */}
      <script
        id="fb-config"
        type="application/json"
        set:html={JSON.stringify(fb)}
      />

      {!configured && (
        <div class="notice" role="status">
          <strong>Not configured yet.</strong> The Firebase values have not been
          exported at build time, so sign-in and push are unavailable. See
          <code>docs/DEPLOY_FIRESTORE.md</code> in the service repository.
        </div>
      )}

      <!-- Sign-in ------------------------------------------------------- -->
      <section class="card" id="auth" aria-labelledby="auth-heading">
        <h2 id="auth-heading">Sign in</h2>
        <div id="g_id_onload" data-client-id={googleClientId} hidden></div>
        <div id="signin-slot"></div>
        {/*
          A missing client id means loadGoogleIdentity() returns before it
          injects the GIS script, so the slot above stays empty and the page
          looks broken with nothing to indicate why. Say it plainly instead.
        */}
        {!signInConfigured && (
          <p class="notice" role="status">
            <strong>Sign-in is not set up on this deployment.</strong> The
            OAuth web client id is not configured, so no sign-in button can be
            shown. See <code>docs/DEPLOY_FIRESTORE.md</code> in the service
            repository.
          </p>
        )}
        <div id="signed-in" hidden>
          <p>Signed in as <strong id="user-email"></strong></p>
          <button type="button" class="btn ghost" id="sign-out">Sign out</button>
        </div>

        <p class="error" id="auth-error" role="alert" hidden></p>
      </section>

      {/*
        Run history, the settings editor and push are hidden until there is a
        signed-in user, so a visitor who lands here is not shown a control panel
        they cannot use.

        This is presentation, not security: the markup is public and the data is
        not fetched until sign-in succeeds. firestore.rules is the only thing
        that actually authorises a read or a write.
      */}
      <section class="card" id="history" aria-labelledby="history-heading" hidden>
        <div class="card-head">
          <h2 id="history-heading">Recent runs</h2>
          <button type="button" class="btn ghost" id="refresh">Refresh</button>
        </div>

        <p id="history-empty" class="muted" hidden>
          No runs recorded yet. The Pi writes one after each daily sync.
        </p>

        <dl class="summary" id="summary" hidden>
          <div><dt>Last 15</dt><dd id="s-total">0</dd></div>
          <div><dt>Success</dt><dd id="s-success">0</dd></div>
          <div><dt>Warnings</dt><dd id="s-warn">0</dd></div>
          <div><dt>Errors</dt><dd id="s-error">0</dd></div>
          <div><dt>Emails read</dt><dd id="s-scanned">0</dd></div>
          <div><dt>Events added</dt><dd id="s-created">0</dd></div>
        </dl>

        <ol class="runs" id="runs"></ol>
        <div class="pager" id="runs-pager" hidden></div>
        <p class="stamp" id="runs-page-label"></p>
      </section>


      <!-- Config editor -------------------------------------------------- -->
      <section class="card" id="config" aria-labelledby="config-heading" hidden>
        <div class="card-head">
          <h2 id="config-heading">Extraction settings</h2>
          <span class="stamp" id="config-updated"></span>
        </div>

        <p class="muted">
          The Pi reads this before each run. Changes take effect at the next
          05:00 sync.
        </p>

        <div class="field">
          <label for="llm-prompt">Extraction prompt</label>
          <textarea id="llm-prompt" rows="10" spellcheck="false"></textarea>
          <p class="hint">
            Variables available: <code>{'{date}'}</code>, <code>{'{email}'}</code>.
          </p>
        </div>

        <div class="field">
          <label for="whitelist">Allowed sender domains</label>
          <input
            id="whitelist"
            type="text"
            placeholder="school.org, clubs.co.uk"
            autocomplete="off"
          />
          <p class="hint">
            Comma-separated. Leave empty to consider every sender.
          </p>
        </div>

        <div class="field">
          <label for="blacklist-domains">Disallowed sender domains</label>
          <input
            id="blacklist-domains"
            type="text"
            placeholder="amazon.co.uk, steamcommunity.com"
            autocomplete="off"
          />
          <p class="hint">
            Comma-separated. Mail from these senders is always dropped, even if
            the domain is also on the allowed list above.
          </p>
        </div>

        <div class="field">
          <label for="blacklist">Ignored keywords</label>
          <input
            id="blacklist"
            type="text"
            placeholder="unsubscribe, marketing, newsletter"
            autocomplete="off"
          />
          <p class="hint">
            Matching emails are dropped before the model ever sees them.
          </p>
        </div>

        <div class="field">
          <label for="push-template">Notification template</label>
          <input id="push-template" type="text" autocomplete="off" />
          <p class="hint">
            Available: <code>{'{summary}'}</code>, <code>{'{date}'}</code>,
            <code>{'{time}'}</code>.
          </p>
          <p class="preview" id="push-preview"></p>
        </div>

        <p class="error" id="config-errors" role="alert" hidden></p>
        <p class="ok" id="config-saved" role="status" hidden>Saved.</p>

        <p class="notice readonly" id="config-readonly" role="status" hidden>
          These settings are read-only for your account. A parent account can
          change them.
        </p>

        <button type="button" class="btn primary" id="save-config">
          Save settings
        </button>
      </section>

      <!-- Push ----------------------------------------------------------- -->
      <section class="card" id="push" aria-labelledby="push-heading" hidden>
        <h2 id="push-heading">Notifications on this device</h2>
        <p class="muted">
          Subscribe this phone or computer to receive a push when an event is
          added to the family calendar.
        </p>
        <p id="push-state" class="muted"></p>
        <button type="button" class="btn primary" id="enable-push">
          Enable notifications
        </button>
        <p class="hint">
          On iPhone, add this site to the Home Screen first — iOS only delivers
          Web Push to a Home Screen app.
        </p>
        <p class="hint" id="push-blocked-note" hidden>
          If the button appears to do nothing, your browser is blocking
          notifications for this site. Open the padlock or site-settings icon in
          the address bar, allow notifications, then reload this page.
        </p>

        <hr class="rule" />

        <h3>Test this notification path</h3>
        <p class="muted">
          Asks the Pi to send a push to every subscribed device. The Pi picks
          this up on its next check (within a minute) and the result appears
          here, so you can tell a working subscription from one that only looks
          subscribed.
        </p>
        <button type="button" class="btn" id="test-push">
          Send a test notification
        </button>
        <p id="test-push-state" class="muted"></p>

        <hr class="rule" />

        <h3>Show a notification on this device</h3>
        <p class="muted">
          Asks this browser to display a notification right now, without the Pi
          and without the network. It separates the two halves of the problem:
          if this appears but the test push above does not, the device is fine
          and the push did not arrive. If neither appears, the device is
          blocking notifications.
        </p>
        <button type="button" class="btn" id="local-push">
          Show a notification here
        </button>
        <p id="local-push-state" class="muted"></p>
      </section>

      <Footer />
    </article>
  </main>
</BaseLayout>
<style is:global>
  /* Global, not scoped. Astro scopes a rule to [data-astro-cid-...] and adds
     * that attribute only to markup IT renders; everything below is built at
     * runtime with createElement, so a scoped rule never matched it. The symptom
     * was a log block inside the run table keeping white-space:pre and growing
     * the table to 1578px on a 1280px viewport, because the wrapping rules
     * simply were not being applied.
     *
     * The selectors are all specific to this page (.dash, #runs, .card) so they
     * cannot leak into the rest of the site.
     */
  /*
   * The page container, matching src/pages/index.astro so the dashboard lines
   * up with the rest of the site instead of sitting in a narrower column.
   */
  .dash {
    width: 100%;
    max-width: var(--page-max);
    margin: 24px auto 0;
    padding: 0 var(--gutter) 4rem;
  }

  /*
   * Author rules beat the user-agent's `[hidden] { display: none }`, so any
   * element given `display` here (.summary is a grid) stays visible even with
   * the hidden attribute set. This is what actually hides the panel before
   * sign-in, and what lets the summary toggle.
   */
  [hidden] { display: none !important; }

  /* Sign-in ------------------------------------------------------- */

  #signin-slot { min-height: 44px; }
  .dash-head h1 { margin: 0.5rem 0 0.25rem; font-size: 2rem; }
  .dash-sub { color: var(--muted, #5b6472); margin-top: 0; }

  .card {
    border: 1px solid var(--line, #dfe3e8);
    border-radius: 12px;
    padding: 1.25rem;
    margin: 1.25rem 0;
    background: var(--surface, #fff);
  }
  .card h2 { margin-top: 0; font-size: 1.1rem; }
  .card-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .card-head h2 { margin-bottom: 0.25rem; }
  .stamp { font-size: 0.8rem; color: var(--muted, #5b6472); }

  .muted { color: var(--muted, #5b6472); }
  .hint { font-size: 0.85rem; color: var(--muted, #5b6472); margin: 0.35rem 0 0; }
  .error { color: #b3261e; font-weight: 600; }
  .ok { color: #1b5e20; font-weight: 600; }

  .notice {
    border-left: 4px solid #b26a00;
    background: #fff6e5;
    padding: 0.85rem 1rem;
    border-radius: 6px;
    margin: 1rem 0;
  }

  /* Softer than .notice: this is expected state, not a problem to solve. */
  .notice.readonly {
    border-left-color: #5b6472;
    background: #f6f7f9;
    color: var(--muted, #5b6472);
  }

  .summary {
    display: grid;
    /* Five tiles across at 360px leaves ~60px each, which is unreadable. */
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.75rem; margin: 1rem 0;
  }
  .summary div {
    border: 1px solid var(--line, #dfe3e8);
    border-radius: 8px; padding: 0.6rem 0.75rem;
  }
  .summary dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted, #5b6472); }
  .summary dd { margin: 0.2rem 0 0; font-size: 1.4rem; font-weight: 700; }

  /* Run history, one table per day. A flat list of 15 runs across 15 dates was
     unreadable on a phone; a dated table with fixed columns is not. */
  .runs { list-style: none; padding: 0; margin: 0; }
  .day { margin: 1.1rem 0; min-width: 0; }
  .day-heading {
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted, #5b6472); margin: 0 0 0.35rem;
  }
  .run-table {
    /* table-layout:fixed stops a long line stretching a COLUMN, but on its own
       it does not stop the log block inside the cell forcing the table wider:
       a single unbreakable token still sets a minimum width. The cell and the
       block inside it both need their width constrained. */
    table-layout: fixed;
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .run-table th, .run-table td {
    text-align: left; padding: 0.4rem 0.35rem;
    border-bottom: 1px solid var(--line, #dfe3e8);
    vertical-align: top;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  /* The log now spans the whole table as its own row, so the cell is as wide as
     the table and needs no fixed share. The explicit width is kept on the block
     inside it, because `width:100%` against an unresolved cell is what made the
     table overflow to 1402px on a 1280px viewport. */
  .run-table .row-log td { padding-top: 0; padding-bottom: 0.5rem; }
  .run-table .cell-empty {
    color: var(--muted, #5b6472); font-size: 0.75rem; font-style: italic;
  }
  .run-table details {
    display: block; max-width: 100%; min-width: 0;
  }
  .run-table pre {
    white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;
    /* No width:100%. A percentage against an unresolved cell is what caused
       the overflow; letting the pre fill the block it is in is what works. */
    max-width: 100%;
    margin: 0.4rem 0 0; line-height: 1.45;
    background: #f6f7f9; padding: 0.5rem; border-radius: 6px; font-size: 0.75rem;
  }
  .run-table th {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--muted, #5b6472); font-weight: 600;
  }
  .run-table .cell-time { width: 4.5rem; white-space: nowrap; }
  .run-table .cell-num { width: 3.2rem; text-align: right; }
  .run-table summary {
    cursor: pointer; font-size: 0.8rem; color: var(--muted, #5b6472);
  }
  .badge {
    display: inline-block;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em;
    padding: 0.1rem 0.4rem; border-radius: 999px; color: #fff;
  }
  .badge.SUCCESS { background: #1b5e20; }
  .badge.WARN { background: #b26a00; }
  .badge.ERROR { background: #b3261e; }
  .pager {
    display: flex; gap: 0.5rem; justify-content: center;
    margin: 1rem 0 0.25rem; flex-wrap: wrap;
  }
  #runs-page-label { text-align: center; }
  .rule { border: 0; border-top: 1px solid var(--line, #dfe3e8); margin: 1.5rem 0; }
  .card h3 { font-size: 0.95rem; margin: 0 0 0.4rem; }

  .field { margin: 1rem 0; }
  .field label { display: block; font-weight: 600; margin-bottom: 0.3rem; }
  .field input, .field textarea {
    width: 100%; padding: 0.55rem 0.7rem;
    border: 1px solid var(--line, #dfe3e8); border-radius: 6px;
    font: inherit; background: #fff; color: inherit;
  }
  .field textarea { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; }
  .preview {
    margin: 0.5rem 0 0; font-size: 0.85rem;
    background: #f6f7f9; padding: 0.5rem 0.7rem; border-radius: 6px;
  }

  .btn {
    font: inherit; padding: 0.55rem 1rem; border-radius: 8px;
    border: 1px solid var(--line, #dfe3e8); cursor: pointer;
  }
  .btn.primary { background: #1a1d21; color: #fff; border-color: #1a1d21; }
  .btn.ghost { background: transparent; color: inherit; }
  .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
</style>
<script>
  /**
   * Dashboard client.
   *
   * Loaded as a module, and only does anything once Firebase is configured at
   * build time. Every Firestore read and write is authorised by the security
   * rules, never by anything checked here: this code runs on a public static
   * page and cannot be trusted to protect anything.
   */
  import {
    summariseRuns, formatRunId, sortRunsNewestFirst,
    parseTagList, formatTagList, renderPushTemplate, escapeHtml,
    validateConfig, deviceDocumentId, RUNS_QUERY_LIMIT,
    DEFAULT_LLM_PROMPT, DEFAULT_PUSH_TEMPLATE,
  } from '../../lib/dashboard.js';

  /*
   * $ is a getElementById shorthand: it takes a bare id, NOT a CSS selector.
   *
   * These two lookups used to be written as $('#fb-config') and
   * $('#g_id_onload'). The leading '#' made them search for an element whose id
   * was literally "#fb-config", which does not exist, so getElementById
   * returned null and the whole module threw
   *
   *     TypeError: Cannot read properties of null (reading 'textContent')
   *
   * The error killed the script before boot() ran, so the Google Identity
   * Services script was never injected and the page showed the heading
   * "Sign in" with no button under it.
   */
  const $ = (id) => document.getElementById(id);

  /*
   * The Firebase config and OAuth client id are read from the DOM by
   * readBuildConfig() rather than at module scope, so the lookup cannot race
   * the parser regardless of when the module is evaluated.
   */
  let FIREBASE_CONFIG = {};
  let GOOGLE_CLIENT_ID = '';
  let VAPID_KEY = '';

  function readBuildConfig() {
    const node = $('fb-config');
    if (!node) {
      throw new Error('the Firebase config block is missing from the page');
    }
    FIREBASE_CONFIG = JSON.parse(node.textContent);
    GOOGLE_CLIENT_ID = $('g_id_onload')?.dataset.clientId ?? '';
    VAPID_KEY = FIREBASE_CONFIG.vapidKey ?? '';
  }

  const CONFIG_DOC = 'config/app_settings';
  const RUNS_COLLECTION = 'runs';
  const DEVICES_COLLECTION = 'devices';

  /**
   * Sections revealed once someone is signed in.
   *
   * These start hidden in the markup, so the page shows a sign-in card and
   * nothing else until a session exists.
   */
  const PANEL_IDS = ['history', 'config', 'push'];

  /**
   * Addresses allowed to change the extraction settings.
   *
   * This is a *display* concern only. The authoritative check is the
   * `allow write: if isAdmin()` rule in firestore.rules, which cannot be
   * circumvented from the browser - this list only decides whether to show a
   * Save button or a read-only form.
   *
   * The two copies can therefore drift, which is why saveConfig() also handles a
   * permission-denied response rather than assuming this list is right. Keep in
   * step with `isAdmin()` in firebase/firestore.rules.
   */
  const ADMIN_EMAILS = new Set([
    'ryan.lilker@gmail.com',
    'alison.lilker@gmail.com',
  ]);

  // Firebase ESM URLs, imported on demand so an unconfigured dashboard ships
  // almost no JavaScript at all.
  const FB = 'https://www.gstatic.com/firebasejs/11.0.2';
  const firebaseApp = () => import(`${FB}/firebase-app.js`);
  const firebaseAuth = () => import(`${FB}/firebase-auth.js`);
  const firestore = () => import(`${FB}/firebase-firestore.js`);
  const messagingSdk = () => import(`${FB}/firebase-messaging.js`);

  let auth = null;
  let db = null;
  let messaging = null;
  let firestoreNs = null;

  /** True when the signed-in account may change the extraction settings. */
  let isAdmin = false;

  /** Write a status line, choosing the tone class. */
  function say(node, message, tone = 'muted') {
    if (!node) return;
    node.textContent = message;
    node.className = tone === 'muted' ? 'muted' : tone;
  }

  // --- Bootstrap ---------------------------------------------------------

  async function boot() {
    if (!FIREBASE_CONFIG.apiKey) return;  // unconfigured; the markup says so

    const [appNs, authNs, fs, fcm] = await Promise.all([
      firebaseApp(), firebaseAuth(), firestore(), messagingSdk(),
    ]);

    const config = { ...FIREBASE_CONFIG };
    delete config.vapidKey;
    const app = appNs.initializeApp(config);
    auth = authNs.getAuth(app);
    firestoreNs = fs;
    db = fs.getFirestore(app);

    loadGoogleIdentity();

    // Messaging FIRST. onSignedIn() wires the foreground push listener and needs
    // `messaging` to exist; registering the auth listener first left it racing
    // the assignment below, so a fast sign-in could subscribe to nothing and
    // every foreground push was silently dropped.
    try {
      messaging = (await fcm.isSupported()) ? fcm.getMessaging(app) : null;
    } catch {
      messaging = null;
    }

    authNs.onAuthStateChanged(auth, (user) => {
      if (user) onSignedIn(user);
      else onSignedOut();
    });
  }

  // --- Sign-in (Task 3) --------------------------------------------------
  // Google Identity Services returns an ID token, which is exchanged for a
  // Firebase session. No secret is involved at any point: the client id is
  // public by design, and the Firestore rules do the authorising.

  function loadGoogleIdentity() {
    if (!GOOGLE_CLIENT_ID) return;
    window.__handleGoogleId = handleGoogleCredential;

    // Guard against a second injection: GIS logs an error if initialize() is
    // called twice, and the button would be rendered into a slot we just wiped.
    if (window.google?.accounts?.id) {
      renderGoogleButton();
      return;
    }

    const s = document.createElement('script');
    s.src = 'https://accounts.google.com/gsi/client';
    s.async = true;
    s.defer = true;
    /*
     * onAuthStateChanged fires with a null user long before this network
     * request resolves, so onSignedOut() runs while window.google is still
     * undefined. renderGoogleButton() bails out at that point and, without
     * these handlers, nothing ever called it again: the slot stayed empty and
     * the page showed the heading "Sign in" with no button under it.
     *
     * Rendering on load is what puts the button on the page. onerror says why
     * it is missing when the script cannot be fetched at all.
     */
    s.addEventListener('load', renderGoogleButton);
    s.addEventListener('error', () => {
      say($('auth-error'),
        'The Google sign-in script could not be loaded. Check the connection '
        + 'and reload the page.', 'error');
      $('auth-error').hidden = false;
    });
    document.head.appendChild(s);
  }

  async function handleGoogleCredential(response) {
    if (!response?.credential || !auth) return;
    try {
      const authNs = await firebaseAuth();
      const provider = new authNs.GoogleAuthProvider();
      provider.setCustomParameters({ prompt: 'select_account' });
      await authNs.signInWithCredential(
        auth, authNs.GoogleAuthProvider.credential(response.credential));
    } catch (e) {
      // Sign-in problems are reported next to the sign-in card, not in the
      // settings form far down the page where the user is not looking.
      say($('auth-error'), `Sign-in failed: ${e.message}`, 'error');
      $('auth-error').hidden = false;
    }
  }

  function renderGoogleButton() {
    const slot = $('signin-slot');
    if (!slot || !GOOGLE_CLIENT_ID || !window.google?.accounts?.id) return;
    // Signed in: re-rendering would put a second button next to the account.
    if (auth?.currentUser) return;
    slot.innerHTML = '';
    window.google.accounts.id.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: window.__handleGoogleId,
    });
    // The button is 320px wide by default, which overflows a 360px phone once
    // the page gutters and the card padding are added. Measure the slot and
    // clamp: never wider than the container, never so narrow the label clips.
    const available = Math.floor(slot.getBoundingClientRect().width);
    const width = available > 0 ? Math.min(320, Math.max(200, available)) : 320;
    window.google.accounts.id.renderButton(slot, {
      // 'signin_with' renders "Sign in with Google". The previous
      // 'continue_with' said "Continue with Google", which does not match the
      // heading above it.
      theme: 'outline', size: 'large', width, text: 'signin_with',
    });
  }

  function onSignedIn(user) {
    $('signin-slot').hidden = true;
    $('signed-in').hidden = false;
    $('user-email').textContent = user.email ?? '(no email)';
    isAdmin = ADMIN_EMAILS.has((user.email ?? '').toLowerCase());
    setPanelVisible(true);
    applyAdminState();
    setFormEnabled(true);
    loadConfig();
    loadRuns();
    refreshPushState();
    // A push that lands while this tab is open is delivered to the PAGE, not
    // the service worker, and the SDK does not display it for you. Without this
    // the notification silently disappears whenever the dashboard happens to
    // be on screen - including when you are pressing the test button.
    listenForForegroundMessages();
    $('config-updated').textContent = `Signed in as ${user.email ?? ''}`;
  }

  function onSignedOut() {
    $('signin-slot').hidden = false;
    $('signed-in').hidden = true;
    isAdmin = false;
    setPanelVisible(false);
    applyAdminState();
    $('runs').innerHTML = '';
    $('summary').hidden = true;
    $('history-empty').hidden = true;
    setFormEnabled(false);
    renderGoogleButton();
  }

  /**
   * Show or hide the parts of the page that only make sense for a signed-in
   * family member.
   *
   * Purely cosmetic. Nothing here is confidential and nothing here is an
   * access control: the markup is served to anyone who requests it, and no
   * Firestore read or write is issued until a session exists. firestore.rules
   * decides who may actually read the runs or change the settings.
   */
  function setPanelVisible(visible) {
    for (const id of PANEL_IDS) {
      const node = $(id);
      if (node) node.hidden = !visible;
    }
  }

  /**
   * Settings are admin-only. Everyone else still sees them, because the push
   * preview and the saved-prompt text are useful to read, but the controls are
   * inert and the reason is stated rather than left for them to guess at.
   */
  function applyAdminState() {
    const note = $('config-readonly');
    const save = $('save-config');
    // readOnly is SET UNCONDITIONALLY, in both branches.
    //
    // It used to be set only in the else branch, so it could never be cleared:
    // onAuthStateChanged fires with a null user first, applyAdminState() set
    // readOnly on every field at that point, and when a parent then signed in
    // the flag stayed. The fields looked normal - focusable, focus-styled,
    // showing a value - but swallowed every keystroke, which is what "acts like
    // a button when pressed" describes. This is why a readOnly check written as
    // "is it disabled?" passed while typing was impossible.
    for (const id of ['llm-prompt', 'whitelist', 'blacklist-domains',
      'blacklist', 'push-template']) {
      const el = $(id);
      if (el) el.readOnly = !isAdmin;
    }

    if (isAdmin) {
      note.hidden = true;
      save.hidden = false;
    } else {
      note.hidden = false;
      save.hidden = true;
    }
  }

  function setFormEnabled(enabled) {
    for (const id of ['llm-prompt', 'whitelist', 'blacklist-domains',
      'blacklist', 'push-template']) {
      const el = $(id);
      if (el) el.disabled = !enabled;
    }
    $('save-config').disabled = !enabled;
    $('enable-push').disabled = !enabled;
  }

  // --- Run history (Task 4) ----------------------------------------------
  // Bounded to the latest 15 runs: an unbounded read would be both a billing
  // problem and a bulk export of the family's history.

  async function loadRuns() {
    if (!db) return;
    try {
      const snapshot = await firestoreNs.getDocs(
        firestoreNs.query(
          firestoreNs.collection(db, RUNS_COLLECTION),
          firestoreNs.orderBy('timestamp', 'desc'),
          firestoreNs.limit(RUNS_QUERY_LIMIT),
        ),
      );
      const runs = sortRunsNewestFirst(
        snapshot.docs.map((d) => ({ run_id: d.id, ...d.data() })),
      );
      runCache = runs;
      renderRuns(runs);
    } catch (e) {
      // permission-denied here almost always means this email is not on the
      // allowlist in firestore.rules, which is worth saying plainly.
      say($('history-empty'),
        `Could not load run history: ${e.message}`, 'error');
      $('history-empty').hidden = false;
    }
  }

  /** Days shown per page of history. */
  const RUNS_PAGE_DAYS = 7;

  /** Cached runs and the current page, so paging needs no re-query. */
  let runCache = [];
  let runPage = 0;
  let runPageCount = 1;

  /** Day key (YYYY-MM-DD) a run belongs to, from its run_id. */
  function runDayKey(runId) {
    const day = String(runId ?? '').slice(0, 8);
    return /^\d{8}$/.test(day)
      ? `${day.slice(0, 4)}-${day.slice(4, 6)}-${day.slice(6, 8)}`
      : 'unknown';
  }

  /** Group runs by day, newest day first, preserving order within a day. */
  function groupRunsByDay(runs) {
    const groups = new Map();
    for (const run of runs) {
      const key = runDayKey(run.run_id);
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(run);
    }
    return [...groups.entries()]
      .sort((a, b) => (a[0] < b[0] ? 1 : a[0] > b[0] ? -1 : 0));
  }

  function renderRuns(runs) {
    const list = $('runs');
    list.innerHTML = '';
    $('history-empty').hidden = runs.length > 0;
    $('summary').hidden = runs.length === 0;

    const s = summariseRuns(runs);
    $('s-total').textContent = s.total;
    $('s-success').textContent = s.success;
    $('s-warn').textContent = s.warn;
    $('s-error').textContent = s.error;
    $('s-scanned').textContent = s.emailsScanned;
    $('s-created').textContent = s.eventsCreated;

    const days = groupRunsByDay(runs);
    runPageCount = Math.max(1, Math.ceil(days.length / RUNS_PAGE_DAYS));
    if (runPage > runPageCount - 1) runPage = runPageCount - 1;
    const page = days.slice(runPage * RUNS_PAGE_DAYS,
      (runPage + 1) * RUNS_PAGE_DAYS);

    renderPager();

    for (const [day, dayRuns] of page) {
      // One table per day. A single list of 15 runs across 15 dates scrolled
      // off the side of a phone; a dated table with fixed columns does not.
      const wrap = document.createElement('section');
      wrap.className = 'day';

      const heading = document.createElement('h3');
      heading.className = 'day-heading';
      heading.textContent = new Date(`${day}T00:00:00`).toLocaleDateString(
        undefined, { weekday: 'long', day: 'numeric', month: 'long' });
      wrap.appendChild(heading);

      const table = document.createElement('table');
      table.className = 'run-table';
      table.innerHTML = `
        <thead><tr>
          <th scope="col">Time</th>
          <th scope="col">Result</th>
          <th scope="col">Emails</th>
          <th scope="col">Events</th>
        </tr></thead><tbody></tbody>`;
      const tbody = table.querySelector('tbody');

      for (const run of dayRuns) {
        const status = String(run.status ?? 'UNKNOWN').toUpperCase();
        const logs = Array.isArray(run.logs) ? run.logs : [];
        // Two rows per run: a compact summary, then the log spanning the whole
        // table. The log used to be squeezed into a fifth column, where a
        // wrapped stack of lines was narrow and hard to read - especially on a
        // phone. Full width is what makes it legible.
        const tr = document.createElement('tr');
        // Every interpolated value goes through escapeHtml. Log lines contain
        // email subjects, which an outside party can influence.
        tr.innerHTML = `
          <td class="cell-time">${escapeHtml(formatRunId(run.run_id).split(' ').pop())}</td>
          <td><span class="badge ${escapeHtml(status)}">${escapeHtml(status)}</span></td>
          <td class="cell-num">${escapeHtml(run.emails_scanned ?? 0)}</td>
          <td class="cell-num">${escapeHtml(run.events_created ?? 0)}</td>`;

        const logRow = document.createElement('tr');
        logRow.className = 'row-log';
        const logCell = document.createElement('td');
        // colSpan, not a fixed number of columns: it must track the header, or
        // adding a column later silently breaks the row.
        logCell.colSpan = 4;
        if (logs.length) {
          const details = document.createElement('details');
          const summary = document.createElement('summary');
          summary.textContent = `Log - ${logs.length} line${logs.length === 1 ? '' : 's'}`;
          const pre = document.createElement('pre');
          pre.textContent = logs.join('\n');
          details.append(summary, pre);
          logCell.appendChild(details);
        } else {
          logCell.textContent = 'No log lines recorded.';
          logCell.className = 'cell-empty';
        }
        logRow.appendChild(logCell);
        tbody.append(tr, logRow);
      }
      wrap.appendChild(table);
      list.appendChild(wrap);
    }
  }

  /** Days on the current page, as "3 Oct – 9 Oct". */
  function renderPager() {
    const pager = $('runs-pager');
    pager.innerHTML = '';
    $('runs-page-label').textContent =
      runPageCount > 1 ? `Page ${runPage + 1} of ${runPageCount}` : '';
    pager.hidden = runPageCount <= 1;
    if (runPageCount <= 1) return;

    const older = document.createElement('button');
    older.type = 'button';
    older.className = 'btn ghost';
    older.textContent = 'Newer';
    older.disabled = runPage === 0;
    older.addEventListener('click', () => { runPage = Math.max(0, runPage - 1); renderRuns(runCache); });

    const newer = document.createElement('button');
    newer.type = 'button';
    newer.className = 'btn ghost';
    newer.textContent = 'Older';
    newer.disabled = runPage >= runPageCount - 1;
    newer.addEventListener('click', () => { runPage = Math.min(runPageCount - 1, runPage + 1); renderRuns(runCache); });

    pager.append(older, newer);
  }

  // --- Config editor ------------------------------------------------------

  async function loadConfig() {
    if (!db) return;
    try {
      const snap = await firestoreNs.getDoc(firestoreNs.doc(db, CONFIG_DOC));
      const data = snap.exists() ? snap.data() : {};
      // Fall back to the service defaults rather than showing empty boxes.
      //
      // config/app_settings does not exist until somebody saves it, and
      // snap.exists() is false until then. The dashboard therefore rendered four
      // blank fields that looked broken and, because they were empty rather
      // than greyed out, appeared to be uneditable. The Pi runs on exactly these
      // defaults, so showing them is also the honest description of what is in
      // force tonight.
      $('llm-prompt').value = data.llm_prompt_template ?? DEFAULT_LLM_PROMPT;
      $('whitelist').value = formatTagList(data.whitelist_domains ?? []);
      $('blacklist-domains').value = formatTagList(data.blacklist_domains ?? []);
      $('blacklist').value = formatTagList(data.blacklist_keywords ?? []);
      $('push-template').value = data.push_template ?? DEFAULT_PUSH_TEMPLATE;
      $('config-updated').textContent = data.updated_at
        ? `Last changed ${new Date(data.updated_at).toLocaleString()}`
        : 'Using service defaults (never saved)';
      renderPreview();
    } catch (e) {
      say($('config-errors'), `Could not load settings: ${e.message}`, 'error');
      $('config-errors').hidden = false;
    }
  }

  function renderPreview() {
    const rendered = renderPushTemplate($('push-template').value, {
      summary: 'Dentist appointment',
      date: '2026-10-15',
      time: '14:30',
    });
    $('push-preview').textContent = `Preview: ${rendered}`;
  }

  async function saveConfig() {
    const errorsNode = $('config-errors');
    const savedNode = $('config-saved');
    errorsNode.hidden = true;
    savedNode.hidden = true;

    const payload = {
      llm_prompt_template: $('llm-prompt').value,
      whitelist_domains: parseTagList($('whitelist').value),
      blacklist_domains: parseTagList($('blacklist-domains').value),
      blacklist_keywords: parseTagList($('blacklist').value),
      push_template: $('push-template').value.trim(),
      updated_at: new Date().toISOString(),
    };

    // Validate before writing. The Pi reads this document at 05:00 with nobody
    // watching, so a bad save has to be caught here rather than at 5am.
    const problems = validateConfig(payload);
    if (problems.length) {
      say(errorsNode, problems.join(' '), 'error');
      errorsNode.hidden = false;
      return;
    }

    const button = $('save-config');
    button.disabled = true;
    try {
      await firestoreNs.setDoc(
        firestoreNs.doc(db, CONFIG_DOC), payload, { merge: true });
      savedNode.hidden = false;
      $('config-updated').textContent =
        `Last changed ${new Date().toLocaleString()}`;
    } catch (e) {
      // The security rules are authoritative, not ADMIN_EMAILS. If that list has
      // drifted from firestore.rules, Firestore says no - and saying so plainly
      // beats a save button that appears to do nothing.
      if (/permission|denied/i.test(e?.message ?? '')) {
        say(errorsNode,
          'Your account is not allowed to change these settings. Firestore '
          + 'rejected the write, so nothing was saved.', 'error');
      } else {
        say(errorsNode, `Could not save: ${e.message}`, 'error');
      }
      errorsNode.hidden = false;
    } finally {
      button.disabled = false;
    }
  }

  // --- Test notification --------------------------------------------------
  //
  // The browser cannot send a push itself: FCM credentials live on the Pi. So
  // the button writes a request document and the Pi's existing daemon picks it
  // up on its next one-minute check. The result is polled back, which makes the
  // button an end-to-end check of the whole path rather than a guess.

  const TEST_MESSAGES_COLLECTION = 'test_messages';

  async function requestTestNotification() {
    const node = $('test-push-state');
    const button = $('test-push');
    const user = auth?.currentUser;
    if (!user) {
      say(node, 'Sign in first.', 'error');
      return;
    }

    button.disabled = true;
    say(node, 'Asking the Pi to send a test notification...');

    // `await` is required: deviceDocumentId is async (it hashes with Web Crypto),
    // so without it this passed a Promise as the document id and Firestore
    // failed with "s.indexOf is not a function". The id is a hash, so a request
    // cannot be guessed and the listing does not leak who is testing.
    const requestId = await deviceDocumentId(
      `${user.email}:${new Date().toISOString()}:${Math.random()}`);
    try {
      await firestoreNs.setDoc(
        firestoreNs.doc(db, TEST_MESSAGES_COLLECTION, requestId),
        {
          requested_by: user.email,
          requested_at: new Date().toISOString(),
          status: 'pending',
          title: 'Family Assistant',
          body: 'Test notification - push is working.',
        },
      );
    } catch (e) {
      button.disabled = false;
      say(node, /permission|denied/i.test(e?.message ?? '')
        ? 'Your account cannot request a test notification.'
        : `Could not queue it: ${e.message}`, 'error');
      return;
    }

    // The Pi polls once a minute. Poll for the outcome rather than guessing.
    // 1.5s here so a test can observe the loop; the real cost is one read.
    const deadline = Date.now() + 90_000;
    while (Date.now() < deadline) {
      await new Promise((r) => setTimeout(r, 1500));
      try {
        const snap = await firestoreNs.getDoc(
          firestoreNs.doc(db, TEST_MESSAGES_COLLECTION, requestId));
        if (!snap.exists()) continue;
        const data = snap.data() ?? {};
        if (data.status === 'pending') continue;
        if (data.status === 'expired') {
          say(node, 'The Pi did not pick it up within five minutes. Is the '
            + 'family_planner service running?', 'error');
        } else if (data.sent > 0) {
          // Wording matters here. Firebase accepting the message is NOT proof
          // it was displayed: for web push, delivery depends on the browser
          // holding a live connection to Google's servers, and a phone that
          // cannot does not report an error. So this says "handed to Google",
          // not "delivered", and points at the local test that CAN confirm it.
          say(node, `Handed to Google for ${data.sent} device`
            + `${data.sent === 1 ? '' : 's'}. That is not yet proof it was `
            + 'displayed. Use "Show a notification here" below: if that appears '
            + 'but this one does not, the device is fine and the push was '
            + 'dropped in delivery.', 'ok');
        } else {
          say(node, `No subscribed devices (${data.devices ?? 0} known). `
            + 'Enable notifications on this device first.', 'error');
        }
        button.disabled = false;
        return;
      } catch (e) {
        // A read failure is not a reason to give up; try again.
      }
    }
    button.disabled = false;
    say(node, 'Still waiting for the Pi. It checks once a minute - try again in '
      + 'a moment.', 'error');
  }

  // --- Push subscription --------------------------------------------------

  async function refreshPushState() {
    const node = $('push-state');
    if (!('Notification' in window)) {
      say(node, 'This browser does not support notifications.');
      return;
    }
    if (Notification.permission === 'denied') {
      // The button is NOT disabled here. Once a browser has blocked a site it
      // never prompts again, so a disabled button with no way forward is the
      // "pressing it does nothing" case. Instead the state line says what to
      // do, and the button stays available in case the user re-enabled
      // notifications in browser settings without reloading.
      say(node, 'Notifications are blocked for this site. A browser will not '
        + 'ask again once blocked: re-enable notifications for ryanlilker.com '
        + 'in your browser site settings, then reload this page and press the '
        + 'button again.', 'error');
      return;
    }
    if (Notification.permission === 'granted' && messaging) {
      say(node, 'Notifications are enabled on this device.');
      return;
    }
    say(node, 'Not enabled on this device yet.');
  }

  /**
 * Register the worker, making sure the one we get is the CURRENT one.
 *
 * navigator.serviceWorker.register() returns the EXISTING registration when one
 * is already registered for the URL, and only fetches the new script in the
 * background. So after any fix to firebase-sw.js, the page kept talking to the
 * worker the previous build had installed: registration "succeeded", the INIT
 * ack never arrived, and the user was told the worker did not start - or, when
 * the page gave up quietly first, that the button did nothing.
 *
 * updateViaCache bypasses the HTTP cache, and we wait for the new worker to
 * reach "activated" before proceeding, so the handshake is always with the code
 * that is actually deployed.
 */
async function registerWorker() {
  if (!('serviceWorker' in navigator)) {
    throw new Error('This browser has no service worker support.');
  }
  const registration = await navigator.serviceWorker.register(
    '/family-assistant/firebase-sw.js',
    // MODULE, not classic. firebase-sw.js uses top-level `import`, which is
    // only legal in a module worker. Registered as classic - the default -
    // the browser throws a SyntaxError while evaluating the script and
    // registration fails with "ServiceWorker script evaluation failed".
    { type: 'module', updateViaCache: 'none' },
  );

  await registration.update();

  // Wait for any installing worker to take over, so we do not handshake with
  // the stale one. Bounded, because a worker that fails to evaluate never
  // activates - and then the honest thing is to report that, not hang.
  const activating = registration.installing || registration.waiting;
  if (activating) {
    await new Promise((resolve) => {
      const done = () => resolve();
      activating.addEventListener('statechange', () => {
        if (activating.state === 'activated'
          || activating.state === 'redundant') done();
      });
      setTimeout(done, 5000);
    });
  }

  await navigator.serviceWorker.ready;
  return registration;
  }

  async function enablePush() {
    const node = $('push-state');
    const button = $('enable-push');
    button.disabled = true;
    // Say something immediately. The previous version left the button inert
    // while it worked, which is indistinguishable from a broken page.
    say(node, 'Requesting permission from your browser...');

    try {
      // getToken() rejects with an opaque SDK error when vapidKey is empty, so
      // check first and say something useful. This is reachable in practice:
      // the Firebase web config and the VAPID key are set at different times.
      if (!VAPID_KEY) {
        say(node, 'Push is not set up on this site yet. The Firebase web config '
          + 'is present but the Web Push certificate (VAPID key) is missing, so '
          + 'no notifications can be subscribed. See docs/DEPLOY_FIRESTORE.md '
          + 'section 4.', 'error');
        return;
      }

      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        say(node, permission === 'denied'
          ? 'Notifications are blocked for this site. A browser will not ask '
            + 'again once blocked - re-enable it for ryanlilker.com in your '
            + 'browser site settings, then reload this page.'
          : 'Permission was not granted, so no notifications will arrive.',
        permission === 'denied' ? 'error' : 'muted');
        return;
      }
      if (!messaging) {
        say(node, 'Push is not supported here. On iPhone, add the site to the '
          + 'Home Screen first.', 'error');
        return;
      }

      say(node, 'Starting the notification worker...');
      let registration;
      try {
        registration = await registerWorker();
      } catch (e) {
        say(node, `The notification worker could not be started: ${e.message}`,
          'error');
        return;
      }

      // The worker lives in public/, so its config cannot be baked in at build
      // time. Hand it over and wait for the ack: getToken() fails if messaging
      // was never initialised inside the worker.
      const ready = await initWorker(registration);
      if (!ready) {
        say(node, 'The notification worker started but did not acknowledge. '
          + 'This usually means an old version is cached - reload the page '
          + 'once, or clear site data, then try again.', 'error');
        return;
      }

      say(node, 'Requesting a push token from Google...');
      const fcm = await messagingSdk();
      const token = await fcm.getToken(messaging, {
        vapidKey: VAPID_KEY,
        serviceWorkerRegistration: registration,
      });
      if (!token) {
        say(node, 'This browser did not return a push token.', 'error');
        return;
      }

      await storeDeviceToken(token);
      say(node, 'Notifications are enabled on this device.');
    } catch (e) {
      say(node, `Could not enable notifications: ${e.message}`, 'error');
    } finally {
      button.disabled = false;
    }
  }

  /**
   * Ask THIS device to display a notification, with no Pi and no network.
   *
   * FCM reporting "1 of 1 devices notified" only means Google accepted the
   * message. It says nothing about whether the browser displayed it, so a
   * missing notification has two very different causes. This removes the Pi
   * from the equation: if it appears, the device is healthy and delivery is the
   * problem; if it does not, the device is blocking notifications.
   */
  /**
   * Display a notification that arrived while this page is in the foreground.
   *
   * This is why "the Pi said it sent to 1 device" could show nothing: with the
   * dashboard open and controlling the worker, the Firebase SDK delivers the
   * push to the PAGE via onMessage and does NOT auto-display it. The
   * service worker's push listener does not run in that case either. So a user
   * who pressed the test button with the page open - which is exactly what one
   * would do - got silence, while every part of the system reported success.
   *
   * Deferring to the worker keeps one code path for displaying notifications,
   * so a foreground and a background push cannot drift apart.
   */
  async function handleForegroundMessage(payload) {
    const n = payload?.notification ?? {};
    const title = n.title || 'Family Assistant';
    const body = n.body || '';
    // A data-only test push carries the payload under `data`; when there is a
    // `notification` block there may be no data at all, so default to {} rather
    // than null and never read through it unguarded.
    const fromData = payload?.data ?? {};
    const text = body || fromData.body || 'The family calendar has been updated.';

    // A refresh is useful when the tab is open anyway, but it must not be what
    // makes the notification appear.
    if (typeof fromData.action === 'string' || fromData.type) refreshRunsSoon();

    // Foreground display goes through the REGISTRATION directly, not through a
    // message to the worker. Two reasons, both learned the hard way:
    //
    //  - `new Notification()` is not supported from a page in Chrome for
    //    Android. It does not throw; it does nothing.
    //  - Posting to the worker means depending on the worker being CURRENT.
    //    After an update, navigator.serviceWorker.controller is still the
    //    previous worker until the page reloads, so a foreground push could be
    //    handled by code that predates SHOW_LOCAL and vanish silently.
    //
    // ServiceWorkerRegistration.showNotification is the supported page-side API
    // and has neither problem.
    try {
      const reg = await navigator.serviceWorker?.getRegistration();
      if (reg) {
        await reg.showNotification(title, {
          body: text,
          tag: 'family-assistant-live',
          data: { url: '/family-assistant/dashboard' },
        });
        return;
      }
      // eslint-disable-next-line no-new
      new Notification(title, { body: text, tag: 'family-assistant-live' });
    } catch (e) {
      // Nothing useful to say to the user here - a missed refresh is harmless.
      // Logged so a future report of "nothing happened" has something to read.
      console.warn('[family-assistant] could not display a notification:', e);
    }
  }

  /** Debounced refresh so a burst of pushes does not cause a burst of reads. */
  function refreshRunsSoon() {
    clearTimeout(refreshRunsSoon._timer);
    refreshRunsSoon._timer = setTimeout(() => {
      loadRuns().catch(() => {});
    }, 1500);
  }

  /** Wire the foreground listener. Idempotent, so a re-sign-in cannot double it. */
  async function listenForForegroundMessages() {
    if (!messaging) return;
    if (listenForForegroundMessages._done) return;
    listenForForegroundMessages._done = true;
    try {
      const fcm = await messagingSdk();
      if (typeof fcm.onMessage !== 'function') return;
      fcm.onMessage(messaging, handleForegroundMessage);
    } catch {
      // Not fatal: background pushes still work through the service worker.
      listenForForegroundMessages._done = false;
    }
  }

  /**
   * Ask a worker to display a notification and wait for it to say what happened.
   *
   * Resolves to a report string. Resolves even on failure: the whole point is to
   * tell the user WHICH half is broken, so a report that only appears on success
   * is useless.
   */
  function askWorkerToShow(registration, title, body, timeoutMs = 6000) {
    const worker = registration.active || navigator.serviceWorker.controller;
    if (!worker) return Promise.resolve('No active notification worker on this device.');

    return new Promise((resolve) => {
      const channel = new MessageChannel();
      const timer = setTimeout(() => {
        channel.port1.close();
        // A worker that never answers is almost always a stale one: it was
        // installed before SHOW_LOCAL existed and ignores the message.
        resolve('The notification worker did not answer. It is probably an old '
          + 'version - close every tab for this site, reopen the dashboard, and '
          + 'try again.');
      }, timeoutMs);
      channel.port1.onmessage = (event) => {
        clearTimeout(timer);
        channel.port1.close();
        const reply = event.data ?? {};
        resolve(reply.ok
          ? 'The worker asked the browser to display a notification. If nothing '
            + 'appears, the device is blocking notifications - check Android '
            + 'Settings > Apps > Chrome > Notifications.'
          : `The browser refused to display it: ${reply.error}`);
      };
      worker.postMessage({ type: 'SHOW_LOCAL', title, body }, [channel.port2]);
    });
  }

  async function showLocalNotification() {
    const node = $('local-push-state');
    const button = $('local-push');

    if (typeof Notification === 'undefined') {
      say(node, 'This browser does not support notifications at all.', 'error');
      return;
    }
    if (Notification.permission !== 'granted') {
      say(node,
        `Permission is "${Notification.permission}", not "granted". Until it is `
        + 'granted the device cannot display anything, which would fully explain '
        + 'a missing push. Open the padlock or site-settings icon in the address '
        + 'bar, allow notifications, then reload.', 'error');
      return;
    }

    button.disabled = true;
    try {
      const registration = await registerWorker();
      const report = await askWorkerToShow(
        registration, 'Family Assistant',
        'Local test - this device can show notifications.');
      say(node, report, report.includes('refused') || report.includes('did not answer')
        ? 'error' : '');
      // If the worker path failed, try the page's own registration API. Note:
      // `new Notification()` is not an option - Chrome for Android does not
      // support constructing one from a page, and it fails silently.
      if (report.includes('refused') || report.includes('did not answer')) {
        try {
          await registration.showNotification('Family Assistant', {
            body: 'Local test via the page, not the worker.',
            tag: 'family-assistant-local-direct',
          });
          say(node, `${report} A second attempt through the page's own `
            + 'registration API was accepted.', '');
        } catch (e) {
          say(node, `${report} The page's own API also failed: ${e.message}`,
            'error');
        }
      }
    } catch (e) {
      say(node, `Could not reach the notification worker: ${e.message}`, 'error');
    } finally {
      button.disabled = false;
    }
  }

  /** postMessage handshake; resolves false if the worker never acknowledges. */
  function initWorker(registration, timeoutMs = 5000) {
    return new Promise((resolve) => {
      const worker = registration.active || navigator.serviceWorker.controller;
      if (!worker) {
        resolve(false);
        return;
      }
      const channel = new MessageChannel();
      const timer = setTimeout(() => {
        channel.port1.close();
        resolve(false);
      }, timeoutMs);
      channel.port1.onmessage = (event) => {
        clearTimeout(timer);
        channel.port1.close();
        resolve(Boolean(event.data?.ok));
      };
      worker.postMessage(
        { type: 'INIT', config: { ...FIREBASE_CONFIG }, vapidKey: VAPID_KEY },
        [channel.port2],
      );
    });
  }

  async function storeDeviceToken(token) {
    const user = auth?.currentUser;
    if (!user) return;
    // The document id is a hash of the token. Reading the devices collection
    // therefore does not expose working push credentials, and no token can be
    // guessed from a document listing.
    const id = await deviceDocumentId(token);
    await firestoreNs.setDoc(firestoreNs.doc(db, DEVICES_COLLECTION, id), {
      token,
      owner: user.email,
      platform: navigator.userAgent.slice(0, 120),
      updated_at: new Date().toISOString(),
    });
  }

  // --- Wire up -----------------------------------------------------------

  function wire() {
    $('save-config')?.addEventListener('click', saveConfig);
    $('enable-push')?.addEventListener('click', enablePush);
    $('test-push')?.addEventListener('click', requestTestNotification);
  $('local-push')?.addEventListener('click', showLocalNotification);
    $('refresh')?.addEventListener('click', loadRuns);
    $('sign-out')?.addEventListener('click', async () => {
      const authNs = await firebaseAuth();
      await authNs.signOut(auth);
    });
    $('push-template')?.addEventListener('input', renderPreview);
  }

  /**
   * Start once the DOM is parsed.
   *
   * A module script is normally deferred, so the elements this page reads
   * should already exist. "Normally" is not a guarantee worth depending on:
   * reading them at module scope threw when it did not hold, and the failure
   * was silent to the user. Waiting for readyState removes the assumption.
   */
  function start() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
      return;
    }
    readBuildConfig();
    wire();
    boot().catch((e) => {
      say($('push-state'), `Dashboard could not start: ${e.message}`, 'error');
      say($('auth-error'), `Dashboard could not start: ${e.message}`, 'error');
      $('auth-error').hidden = false;
    });
  }

  start();
</script>
