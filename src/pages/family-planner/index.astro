---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Separator from '../../components/Separator.astro';
import app from '../../data/family-planner.json';

const title = `${app.name} — ${app.tagline}`;
const description = app.summary;
---

<BaseLayout title={title} description={description}>
  <div id="top"></div>

  <Nav current="projects" />

  <main class="page" id="main">
    <article class="app">
      <header class="app-hero">
        <a class="back-link" href="/">
          <span aria-hidden="true">←</span> Back to the CV
        </a>

        <p class="app-status">
          <span class="status-dot" aria-hidden="true"></span>
          {app.status}
        </p>

        <h1 class="app-name">{app.name}</h1>
        <p class="app-tagline">{app.tagline}</p>
        <p class="app-summary">{app.summary}</p>

        <div class="action-row">
          <a class="action-btn primary" href={app.repoUrl} target="_blank" rel="noopener noreferrer">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.5 9.5 0 0 1 12 6.8c.85 0 1.71.12 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
            </svg>
            View the source
          </a>
          <a class="action-btn" href="/family-planner/privacy">Privacy policy</a>
          <a class="action-btn" href="/family-planner/terms">Terms &amp; conditions</a>
        </div>

        <dl class="stats">
          {
            app.heroStats.map((stat) => (
              <div class="stat">
                <dt class="stat-value">{stat.value}</dt>
                <dd class="stat-label">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </header>

      <Separator />

      <section class="block" id="problem">
        <SectionTitle title={app.problem.title} />
        {app.problem.body.map((p) => <p class="prose">{p}</p>)}
      </section>

      <section class="block" id="how">
        <SectionTitle title={app.solution.title} />
        {app.solution.body.map((p) => <p class="prose">{p}</p>)}

        <ol class="pipeline">
          {
            app.pipeline.map((stage) => (
              <li class="stage">
                <span class="stage-step">{stage.step}</span>
                <h3 class="stage-title">{stage.title}</h3>
                <p class="stage-body">{stage.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <Separator />

      <section class="block" id="privacy">
        <SectionTitle title={app.privacy.title} />
        {app.privacy.body.map((p) => <p class="prose">{p}</p>)}
      </section>

      <Separator />

      <section class="block" id="engineering">
        <SectionTitle title={app.engineering.title} />
        {app.engineering.body.map((p) => <p class="prose">{p}</p>)}

        <div class="compare">
          <div class="compare-col problem-col">
            <h3 class="compare-title">What the OS won't allow</h3>
            <ul class="compare-list">
              {
                app.engineering.constraints.map((c) => (
                  <li>
                    <strong>{c.title}</strong>
                    <span>{c.body}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="compare-col solution-col">
            <h3 class="compare-title">How it works around them</h3>
            <ul class="compare-list">
              {app.engineering.solution.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <Separator />

      <section class="block" id="stack">
        <SectionTitle title="Stack" />
        <ul class="stack-list">
          {
            app.stack.map((item) => (
              <li class="stack-item">
                <span class="stack-label">{item.label}</span>
                <span class="stack-detail">{item.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="cta">
        <p class="cta-text">
          The full source, including the deployment scripts and the test suite, is
          on GitHub.
        </p>
        <div class="cta-actions">
          <a class="cta-btn primary" href={app.repoUrl} target="_blank" rel="noopener noreferrer">
            {app.name} on GitHub
          </a>
          <a class="cta-btn" href="/">Back to the CV</a>
        </div>
      </div>

      <footer class="legal-links">
        <p class="legal-label">Legal</p>
        <a href="/family-planner/privacy">Privacy policy</a>
        <span class="legal-pipe" aria-hidden="true">·</span>
        <a href="/family-planner/terms">Terms &amp; conditions</a>
      </footer>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    width: 100%;
    max-width: var(--page-max);
    margin: 24px auto 0;
    padding: 0 var(--gutter);
  }

  .app {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */

  .app-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-muted);
    transition: color var(--dur) var(--ease);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .app-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-btn);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2f9e44;
  }

  .app-name {
    font-size: clamp(40px, 7vw, 84px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .app-tagline {
    font-size: 22px;
    font-weight: 500;
    color: var(--accent);
  }

  .app-summary {
    max-width: 68ch;
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* ── Action row + stats (shared shape with the CV hero) ───────────────── */

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    width: 100%;
    margin-top: 6px;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 46px;
    padding: 0 22px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-btn);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .action-btn .icon {
    width: 19px;
    height: 19px;
  }

  .action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.22);
  }

  .action-btn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: none;
  }

  .action-btn.primary .icon {
    filter: brightness(0) invert(1);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    margin: 10px 0 0;
  }

  .stat {
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-btn);
  }

  .stat-value {
    display: block;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .stat-label {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  /* ── Prose blocks ─────────────────────────────────────────────────────── */

  .block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
  }

  .prose {
    max-width: 70ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ── Pipeline ─────────────────────────────────────────────────────────── */

  .pipeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    width: 100%;
    margin-top: 12px;
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 24px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-btn);
  }

  .stage-step {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .stage-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .stage-body {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* ── Constraint / solution comparison ─────────────────────────────────── */

  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    width: 100%;
    margin-top: 10px;
  }

  .compare-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px 28px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-btn);
  }

  .problem-col {
    box-shadow: inset 0 0 0 1px var(--hairline), var(--shadow-btn);
  }

  .compare-title {
    font-size: 16px;
    font-weight: 600;
  }

  .compare-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .compare-list li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .compare-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
  }

  .solution-col .compare-list li::before {
    background: var(--accent);
  }

  .compare-list strong {
    display: block;
    font-weight: 600;
    color: var(--ink);
  }


  /* ── Stack list ───────────────────────────────────────────────────────── */

  .stack-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px 24px;
    width: 100%;
  }

  .stack-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .stack-label {
    font-size: 16px;
    font-weight: 600;
  }

  .stack-detail {
    font-size: 14px;
    color: var(--ink-muted);
  }

  /* ── CTA + legal links ────────────────────────────────────────────────── */

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 28px 32px;
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-btn);
  }

  .cta-text {
    max-width: 46ch;
    font-size: 17px;
    color: var(--ink-soft);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .cta-btn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: none;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
  }

  .cta-btn:not(.primary):hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .legal-label {
    font-weight: 600;
    color: var(--ink);
  }

  .legal-links a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--dur) var(--ease);
  }

  .legal-links a:hover {
    color: var(--accent);
  }

  .legal-pipe {
    color: var(--hairline);
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */

  @media (max-width: 720px) {
    .app {
      gap: 36px;
    }

    .page {
      margin-top: 8px;
    }

    .stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .app-tagline {
      font-size: 19px;
    }

    .app-summary {
      font-size: 17px;
    }

    .cta {
      padding: 24px;
    }
  }
</style>

