---
import { profile, lastName } from '../data/cv';
---

<section class="intro" id="introduction">
  <div class="hero">
    <h1 class="hero-name">
      <span class="hero-first">{profile.firstName}</span>
      <span class="hero-last">{lastName}</span>
    </h1>
    <p class="hero-role">{profile.role}</p>
  </div>

  <div class="intro-cols">
    {profile.intro.map((para) => <p>{para}</p>)}
  </div>

  <div class="action-row">
    <a class="action-btn brand linkedin" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C21.4 8.75 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2.05-3.3-2.05 0-2.37 1.57-2.37 3.2V21h-4V9Z"></path>
      </svg>
      LinkedIn
    </a>

    <a class="action-btn brand github" href={profile.github} target="_blank" rel="noopener noreferrer">
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.5 9.5 0 0 1 12 6.8c.85 0 1.71.12 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
      </svg>
      GitHub
    </a>
  </div>
</section>


<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
  }

  /* ── Name ─────────────────────────────────────────────────────────────── */

  .hero {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.22em;
    font-size: clamp(48px, 8.5vw, 112px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .hero-last {
    color: var(--ink-muted);
  }

  .hero-role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 400;
    color: var(--ink-soft);
  }

  .hero-sep {
    color: var(--accent);
  }

  .hero-tagline {
    font-weight: 500;
    color: var(--ink);
  }

  /* ── Intro copy — two columns on desktop, as in the reference ────────── */

  .intro-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    max-width: 1000px;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink);
  }

  /* ── Action row ──────────────────────────────────────────────────────── */

  .action-row {
    display: grid;
    /* Two contact buttons: LinkedIn and GitHub. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    margin-top: 4px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 48px;
    padding: 0 20px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-btn);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .action-btn .icon {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
  }

  .action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.22);
  }

  .action-btn:active {
    transform: translateY(0);
  }

  /* Social buttons fill with their brand colour, echoing the reference. */
  .action-btn.brand .icon {
    transition: filter var(--dur) var(--ease);
  }

  .action-btn.linkedin:hover {
    background: var(--linkedin);
    color: #fff;
  }

  .action-btn.github:hover {
    background: var(--github);
    color: #fff;
  }

  .action-btn.linkedin:hover .icon,
  .action-btn.github:hover .icon {
    filter: brightness(0) invert(1);
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */

  @media (max-width: 900px) {
    .intro-cols,
    .action-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hero-role {
      font-size: 17px;
    }

    .intro-cols {
      grid-template-columns: minmax(0, 1fr);
      font-size: 17px;
    }

    .action-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .action-btn {
      justify-content: flex-start;
    }
  }
</style>
