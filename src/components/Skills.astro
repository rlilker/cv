---
import { skillGroups } from '../data/cv';
import SectionTitle from './SectionTitle.astro';
---

<section class="section skills" id="skills">
  <SectionTitle title="Skills" meta="Core Stack & Expertise" />

  <p class="section-desc">
    Three decades of designing and shipping production software — core languages, cloud platforms,
    and engineering practices proven in real-world systems.
  </p>

  <div class="skill-grid">
    {
      skillGroups.map((group) => (
        <article class="skill-card" id={group.id}>
          <h3 class="skill-title">{group.title}</h3>
          <ul class="skill-items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
  }

  .section-desc {
    max-width: 68ch;
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    width: 100%;
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px 28px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-btn);
    transition: transform var(--dur) var(--ease);
  }

  .skill-card:hover {
    transform: translateY(-3px);
  }

  .skill-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .skill-items li {
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .skill-card {
      padding: 22px;
    }
  }
</style>
