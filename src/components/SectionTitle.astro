---
interface Props {
  /** Rendered to the right of the heading — e.g. a count or short note. */
  meta?: string;
  /** The muted, very large heading, exactly as in the reference. */
  title: string;
}

const { title, meta } = Astro.props;
---

<div class="section-head">
  <h2 class="section-title">{title}</h2>
  {meta && <span class="section-meta">{meta}</span>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    width: 100%;
    /* The title and the count sit on one line, but the title can shrink. Without
       this the row refuses to shrink below its content and a long count like
       "62 technologies" pushed the page into horizontal scroll on a phone. */
    min-width: 0;
  }

  .section-title {
    font-size: 40px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink-muted);
    min-width: 0;
  }

  .section-meta {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-muted);
    white-space: nowrap;
    flex: 0 0 auto;
  }

  @media (max-width: 720px) {
    .section-title {
      font-size: 28px;
    }

    /* Below this the count no longer fits beside the heading, so it drops
       under it rather than forcing the row wider than the screen. */
    .section-head {
      flex-wrap: wrap;
      row-gap: 2px;
    }
  }
</style>
