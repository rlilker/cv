---
interface Props {
  /** Rendered to the right of the heading — e.g. a count or short note. */
  meta?: string;
  /** The muted, very large heading, exactly as in the reference. */
  title: string;
}

const { title, meta } = Astro.props;
---

<div class="section-head">
  <h2 class="section-title">{title}</h2>
  {meta && <span class="section-meta">{meta}</span>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    width: 100%;
  }

  .section-title {
    font-size: 40px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink-muted);
  }

  .section-meta {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .section-title {
      font-size: 28px;
    }
  }
</style>
