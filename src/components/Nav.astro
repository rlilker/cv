---
import { navSections, projectLinks } from '../data/cv';

const { current } = Astro.props as { current?: string };
---

<header class="top-nav">
  <nav class="nav-pill nav-links" aria-label="Sections">
    {
      navSections.map((section) => (
        <a href={`/#${section.id}`} aria-current={current === section.id ? 'true' : undefined}>
          {section.label}
        </a>
      ))
    }
    {
      projectLinks.map((project) => (
        <a
          class="nav-project"
          href={project.href}
          aria-current={current === 'projects' ? 'true' : undefined}
        >
          {project.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* the strip is an overlay; only the pills should catch clicks */
    pointer-events: none;
  }

  .nav-pill {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-pill);
    pointer-events: auto;
  }

  .nav-links {
    padding: 0 28px;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    /* Sits on the right now that the brand lozenge is gone, where the links
       already were. */
    margin-left: auto;
    /* Without this the pill refuses to shrink below its content and the
       Family Planner link spills past its rounded right edge. */
    min-width: 0;
  }

  .nav-links a {
    position: relative;
    padding: 4px 2px;
    color: var(--ink);
    opacity: 0.62;
    transition: opacity var(--dur) var(--ease);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav-links a:hover,
  .nav-links a[aria-current='true'] {
    opacity: 1;
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='true']::after {
    transform: scaleX(1);
  }

  /* The project link is a different kind of destination from the in-page
     section anchors, so mark it with an accent dot rather than an underline. */
  .nav-project {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    /* The dot plus the longest label has to fit inside the pill. Without an
       explicit no-shrink basis the flex item could be squeezed and the link
       would read as hanging off the end of the container. */
    flex: 0 0 auto;
  }

  .nav-project::after {
    display: none;
  }

  .nav-project::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
    transition: opacity var(--dur) var(--ease);
  }

  .nav-project:hover,
  .nav-project[aria-current='true'] {
    opacity: 1;
  }

  .nav-project:hover::before,
  .nav-project[aria-current='true']::before {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .top-nav {
      padding: 14px 16px;
      flex-wrap: wrap;
    }

    .nav-links {
      /* Full width on narrow screens so the items stay reachable. The links
         were previously the second child and needed `order` to sit below the
         brand lozenge; with only the links left, order would be a no-op. */
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
      gap: 12px;
      padding: 0 20px;
      font-size: 14px;
    }
  }
</style>
