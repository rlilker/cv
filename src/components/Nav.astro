---
import { profile, navSections, projectLinks } from '../data/cv';

const { current } = Astro.props as { current?: string };
---

<header class="top-nav">
  <div class="nav-pill nav-brand">
    <a class="brand-chip" href="/">{profile.name}</a>
  </div>

  <nav class="nav-pill nav-links" aria-label="Sections">
    {
      navSections.map((section) => (
        <a href={`/#${section.id}`} aria-current={current === section.id ? 'true' : undefined}>
          {section.label}
        </a>
      ))
    }
    {
      projectLinks.map((project) => (
        <a
          class="nav-project"
          href={project.href}
          aria-current={current === 'projects' ? 'true' : undefined}
        >
          {project.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* the strip is an overlay; only the pills should catch clicks */
    pointer-events: none;
  }

  .nav-pill {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-pill);
    pointer-events: auto;
  }

  .nav-brand {
    padding: 0 8px;
  }

  .brand-chip {
    height: var(--chip-h);
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    transition: transform var(--dur) var(--ease);
  }

  .brand-chip:hover {
    transform: scale(1.03);
  }

  .nav-links {
    padding: 0 28px;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .nav-links a {
    position: relative;
    padding: 4px 2px;
    color: var(--ink);
    opacity: 0.62;
    transition: opacity var(--dur) var(--ease);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav-links a:hover,
  .nav-links a[aria-current='true'] {
    opacity: 1;
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='true']::after {
    transform: scaleX(1);
  }

  /* The project link is a different kind of destination from the in-page
     section anchors, so mark it with an accent dot rather than an underline. */
  .nav-project {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .nav-project::after {
    display: none;
  }

  .nav-project::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
    transition: opacity var(--dur) var(--ease);
  }

  .nav-project:hover,
  .nav-project[aria-current='true'] {
    opacity: 1;
  }

  .nav-project:hover::before,
  .nav-project[aria-current='true']::before {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .top-nav {
      padding: 14px 16px;
      flex-wrap: wrap;
    }

    .nav-links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 12px;
      padding: 0 20px;
      font-size: 14px;
    }
  }
</style>
