---
import { profile } from '../data/cv';

const updated = new Intl.DateTimeFormat('en-GB', {
  month: 'short',
  year: 'numeric',
}).format(new Date());
---

<footer class="site-footer">
  <div class="footer-row">
    <div class="footer-left">
      <span class="footer-text">
        <span id="local-clock">--:--:--</span>
        <span class="tz" id="local-tz">UK</span>
      </span>
      <span class="footer-pipe" aria-hidden="true">|</span>
      <span class="footer-text">{profile.location}</span>
    </div>

    <div class="footer-right">
      <span class="footer-text">Updated: {updated}</span>
      <span class="footer-dot" aria-hidden="true"></span>
      <a class="footer-link" href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>

<script>
  // Local time in the profile's timezone. Rendered on the client so the page
  // itself stays fully static (and therefore cacheable at the edge).
  const TIMEZONE = 'Europe/London';

  const clock = document.getElementById('local-clock');
  const tzEl = document.getElementById('local-tz');

  if (clock) {
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
      timeZone: TIMEZONE,
    });

    const tzFormat = new Intl.DateTimeFormat('en-GB', {
      timeZone: TIMEZONE,
      timeZoneName: 'short',
    });

    const tick = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      if (tzEl) {
        const parts = tzFormat.formatToParts(now);
        const name = parts.find((p) => p.type === 'timeZoneName')?.value;
        if (name) tzEl.textContent = name;
      }
    };

    tick();

    // Align to the next whole second so the digits don't visibly stutter.
    setTimeout(() => {
      tick();
      setInterval(tick, 1000);
    }, 1000 - (Date.now() % 1000));
  }
</script>


<style>
  .site-footer {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter) 48px;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 22px;
    border-top: 1px solid var(--hairline);
  }

  .footer-left,
  .footer-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-text {
    font-size: 14px;
    color: var(--ink-muted);
    /* tabular figures stop the ticking clock shifting the layout */
    font-variant-numeric: tabular-nums;
  }

  .tz {
    opacity: 1;
  }

  .footer-pipe {
    color: var(--hairline);
    font-size: 14px;
  }

  .footer-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ink-muted);
  }

  .footer-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
    transition: color var(--dur) var(--ease);
  }

  .footer-link:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .site-footer {
      padding-bottom: 32px;
    }

    .footer-row {
      justify-content: center;
      text-align: center;
    }
  }
</style>
