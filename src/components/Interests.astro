---
import { interests } from '../data/cv';
import SectionTitle from './SectionTitle.astro';
---

<section class="section interests" id="interests">
  <SectionTitle title="Interests" />

  <div class="interests-body">
    <p class="interests-copy">
      Away from engineering, I make time for family, curiosity, and the things that help me recharge.
    </p>

    <ul class="interest-pills">
      {
        interests.map((interest) => (
          <li class="interest-pill">
            <span class="dot" aria-hidden="true" />
            {interest}
          </li>
        ))
      }
    </ul>
  </div>

</section>


<style>
  .interests {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
  }

  .interests-body {
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 100%;
  }

  .interests-copy {
    max-width: var(--measure);
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .interest-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .interest-pill {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-btn);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--dur) var(--ease);
  }

  .interest-pill:hover {
    transform: translateY(-2px);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

</style>
