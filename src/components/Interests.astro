---
import { interests, profile } from '../data/cv';
import SectionTitle from './SectionTitle.astro';
---

<section class="section interests" id="interests">
  <SectionTitle title="Interests" />

  <div class="interests-body">
    <p class="interests-copy">
      Away from the keyboard it is mostly family and friends, reading, and guitar —
      with an ongoing campaign to improve my Spanish, a habit of cooking, and a
      reliable supply of puzzles to lose an evening to.
    </p>

    <ul class="interest-pills">
      {
        interests.map((interest) => (
          <li class="interest-pill">
            <span class="dot" aria-hidden="true" />
            {interest}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="cta">
    <p class="cta-text">Contact Me</p>

    <div class="cta-actions">
      <a class="cta-btn primary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
      <a class="cta-btn" href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </div>
  </div>
</section>


<style>
  .interests {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: 100%;
  }

  .interests-body {
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 100%;
  }

  .interests-copy {
    max-width: 68ch;
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .interest-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .interest-pill {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-btn);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--dur) var(--ease);
  }

  .interest-pill:hover {
    transform: translateY(-2px);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ── Closing call to action ──────────────────────────────────────────── */

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    margin-top: 12px;
    padding: 30px 34px;
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-btn);
  }

  .cta-text {
    font-size: 19px;
    color: var(--ink-soft);
  }

  .cta-text strong {
    font-weight: 600;
    color: var(--ink);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 26px;
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .cta-btn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: none;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
  }

  .cta-btn:not(.primary):hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 560px) {
    .cta {
      padding: 24px;
    }

    .cta-actions {
      width: 100%;
    }

    .cta-btn {
      flex: 1 1 auto;
    }
  }
</style>
