{
  "name": "cv",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Ryan Lilker — CV website. Astro static build deployed to S3 + CloudFront.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "verify": "node scripts/verify-build.mjs",
    "outline": "node scripts/outline-page.mjs",
    "validate:infra": "node scripts/validate-infra.mjs",
    "selftest:infra": "node scripts/selftest-infra.mjs",
    "check:shell": "node scripts/check-workflow-shell.mjs",
    "check": "astro check",
    "test:dashboard": "node scripts/test-dashboard.mjs",
    "build:e2e": "node tests/e2e/build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run build && npm run verify && npm run validate:infra && npm run selftest:infra && npm run check:shell && npm run test:dashboard",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "astro": "^5.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
